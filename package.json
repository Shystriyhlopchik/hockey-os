{
  "name": "hockey-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node backend/dist/main.js",
    "build": "pnpm --dir backend build && pnpm --dir frontend build",
    "test": "pnpm --dir backend test",
    "test:integration": "node scripts/player-identity.integration.mjs && node scripts/player-deletion.integration.mjs && node scripts/integration.mjs",
    "db:up": "docker compose up -d database",
    "db:local": "node scripts/local-db.mjs",
    "db:stop:local": "node scripts/stop-db.mjs",
    "db:stop": "docker compose stop database",
    "setup": "node scripts/setup.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}
