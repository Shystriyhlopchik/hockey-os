{
  "name": "@hockey-os/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4300",
    "build": "ng build",
    "test": "node --experimental-strip-types --test src/core/state/draft-updates.spec.ts src/core/routing/route-state.spec.ts src/features/home/home-summary.spec.ts src/features/calendar/match-calendar.spec.ts src/features/calendar/schedule-editor.spec.ts src/features/protocol/protocol-sheet.spec.ts src/features/players/identity-checks.spec.ts",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\""
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.13",
    "@angular/cli": "^19.2.13",
    "@angular/compiler-cli": "^19.2.0",
    "prettier": "3.6.2",
    "typescript": "~5.7.2"
  }
}
